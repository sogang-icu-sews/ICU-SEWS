# Copy this file to .env. Do not commit the real .env file.
SEWS_ENV=development
SEWS_API_HOST=0.0.0.0
SEWS_API_PORT=8000
SEWS_API_URL=http://api:8000
SEWS_MODEL_DIR=/app/artifacts
SEWS_CONFIG_DIR=/app/configs

# Scaffold-only mode. Change to false after a trained model is connected.
SEWS_USE_MOCK_MODEL=true

# Local MLflow tracking directory
MLFLOW_TRACKING_URI=file:/app/mlruns

