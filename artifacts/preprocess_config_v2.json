  "excluded_features": {
    "EtCO2": "never-measured max 100.0%",
    "HCO3": "never-measured max 97.9%",
    "TroponinI": "never-measured max 97.6%",
    "Bilirubin_direct": "never-measured max 97.2%",
    "BaseExcess": "never-measured max 97.1%",
    "Chloride": "never-measured max 91.9%",
    "Fibrinogen": "never-measured max 90.2%",
    "SaO2": "venous contamination suspected in setA",
    "HospAdmTime": "no predictive value, hospital-specific distribution"
  },
  "redundant_features": {
    "Hct": "Spearman rho 0.941 with Hgb (keep Hgb)",
    "DBP": "Spearman rho 0.834 with MAP (keep MAP; SOFA 기준 변수, 관측률 97% vs 79%)"
  },
  "banned_time_features": {
    "columns": [
      "ICULOS"
    ],
    "name_patterns": [
      "(?i)iculos",
      "(?i)history_h",
      "(?i)(^|_)cum",
      "(?i)(^|_)los($|_)",
      "(?i)since_admit"
    ],
    "reason": "비패혈증 기록이 약 60h에서 잘려 ICULOS<=60 행에서 AUROC 0.491. 패혈증 기록은 t_sepsis+3h에서 끝나 전체 체류 시간은 미래 정보."
  },
  "eval_only_columns": [
    "Patient_ID",
    "set",
    "split",
    "fold",
    "SepsisLabel",
    "rel",
    "t_sepsis",
    "iculos_le60",
    "early_window"
  ],
  "transforms": {
    "unit_merge": {
      "from": [
        "Unit1",
        "Unit2"
      ],
      "to": "Unit",
      "mapping": {
        "Unit1==1": "MICU",
        "Unit2==1": "SICU",
        "both NaN": "Unknown"
      }
    },
    "age_recode": {
      "from": 100,
      "to": 90
    },
    "calcium_ionized_threshold": 3
  },
  "window": {
    "hours": 24,
    "max_value_age_h": 23,
    "since_cap_h": 24,
    "min_obs_dispersion": 2,
    "min_obs_skew": 3
  },
  "feature_vars": {
    "vitals_window": [
      "HR",
      "Temp",
      "Resp",
      "MAP",
      "SBP",
      "O2Sat"
    ],
    "vital_stats": [
      "last",
      "mean",
      "median",
      "std",
      "min",
      "max",
      "iqr",
      "skew",
      "cv",
      "slope",
      "delta6h"
    ],
    "labs": [
      "WBC",
      "Platelets",
      "Creatinine",
      "BUN",
      "Bilirubin_total",
      "Lactate",
      "Glucose",
      "Hgb",
      "Potassium",
      "Magnesium",
      "Phosphate",
      "Calcium",
      "AST",
      "Alkalinephos",
      "FiO2",
      "pH",
      "PaCO2",
      "PTT"
    ],
    "lab_stats": [
      "last",
      "delta_prev"
    ],
    "static": [
      "Age",
      "Gender",
      "Unit"
    ]
  },
  "derived_features": {
    "deviation": {
      "Temp": 37.0,
      "pH": 7.4,
      "PaCO2": 40.0
    },
    "ratio": {
      "BUN_Creatinine": [
        "BUN",
        "Creatinine"
      ]
    },
    "optional": {
      "shock_index": [
        "HR",
        "SBP"
      ]
    }
  },
  "measurement_indicator_groups": {
    "lactate": [
      "Lactate"
    ],
    "fio2": [
      "FiO2"
    ],
    "liver_panel": [
      "AST",
      "Alkalinephos",
      "Bilirubin_total"
    ]
  },
  "no_indicator_features": [
    "DBP",
    "pH",
    "PaCO2",
    "PTT"
  ],
  "sofa": {
    "valid_age_h": 23,
    "components": {
      "coagulation": {
        "var": "Platelets",
        "type": "complete",
        "cuts_desc": [
          150,
          100,
          50,
          20
        ],
        "direction": "lower_worse"
      },
      "liver": {
        "var": "Bilirubin_total",
        "type": "complete",
        "cuts_asc": [
          1.2,
          2.0,
          6.0,
          12.0
        ],
        "direction": "higher_worse"
      },
      "renal": {
        "var": "Creatinine",
        "type": "partial_lower_bound",
        "cuts_asc": [
          1.2,
          2.0,
          3.5,
          5.0
        ],
        "direction": "higher_worse"
      },
      "cardiovascular": {
        "var": "MAP",
        "type": "partial_0_or_1",
        "threshold_lt": 70
      },
      "respiratory": {
        "var": null,
        "type": "not_computable",
        "reason": "PaO2 없음"
      },
      "cns": {
        "var": null,
        "type": "not_computable",
        "reason": "GCS 없음"
      }
    },
    "total": "not_computable",
    "delta": "per_component_sum",
    "states": [
      "OK",
      "STALE",
      "NOT_MEASURED",
      "NOT_COMPUTABLE"
    ]
  },
  "qsofa": {
    "resp_ge": 22,
    "sbp_le": 100,
    "mentation": "not_computable"
  },
  "labels": {
    "sepsis": {
      "source": "SepsisLabel",
      "extra_shift_h": 0
    },
    "renal_24h": {
      "enabled": false,
      "definition": "KDIGO creatinine (+0.3 in 48h or 1.5x baseline)",
      "horizon_h": 24
    }
  }
}